# Profile language metrics exclusions.
#
# Forks are excluded automatically. All owned public and private repositories
# are included; repository-level exclusions are disabled. Path rules below only
# remove generated artifacts from the language calculation.

# Generated build output and dependency trees.
path:**/.next/**
path:**/.nuxt/**
path:**/.svelte-kit/**
path:**/artifacts/**
path:**/build/**
path:**/coverage/**
path:**/dist/**
path:**/node_modules/**
path:**/out/**
path:**/target/**

# Generated/minified web bundles.
path:**/*.svg
path:**/*.min.js
path:**/*.min.css
path:**/bundle.js
path:**/bundle.css
path:**/vendor.js
path:**/vendor.css

# Obsidian installed-plugin bundles inside vault repositories.
path:**/.obsidian*/plugins/**/main.js
path:**/.obsidian*/plugins/**/styles.css
